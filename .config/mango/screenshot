#!/bin/sh

set -eu

case "${1:-area}" in
  area)
    geometry=$(slurp) || exit 0
    [ -n "$geometry" ] || exit 0
    grim -g "$geometry" - | wl-copy
    ;;
  window)
    client=$(mmsg get focusing-client) || exit 0
    geometry=$(printf '%s' "$client" | jq -er 'select(.id != null) | "\(.x),\(.y) \(.width)x\(.height)"') || exit 0
    grim -g "$geometry" - | wl-copy
    ;;
  output)
    output=$(slurp -o -f '%o') || exit 0
    [ -n "$output" ] || exit 0
    grim -o "$output" - | wl-copy
    ;;
  *)
    exit 2
    ;;
esac

notify-send -a mango "Screenshot copied"
