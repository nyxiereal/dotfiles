{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.6-sol",

  "disabled_providers": [
    "morph",
    "mistral",
    "kimi-for-coding",
    "google-vertex-anthropic",
    "deepseek",
    "anthropic"
  ],

  "provider": {
    "openai": {
      "options": {
        "chunkTimeout": 180000
      },
      "models": {
        "gpt-5.6": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-pro": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-luna-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-luna-pro": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-pro": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-terra-fast": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-5.6-terra-pro": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        }
      }
    }
  },

  // MCP servers
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "httptoolkit": {
      "type": "local",
      "command": [
        "/opt/HTTP Toolkit/resources/httptoolkit-mcp"
      ],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/metrolistgroup",
      "enabled": true,
      "oauth": {}
    }
  },

  // Custom slash commands
  "command": {
    "commitpush": {
      "description": "Stage, commit (following repo conventions), and push with user confirmation on the commit message",
      "model": "opencode-go/deepseek-v4-flash",
      "template": "Read the git log with `git log --oneline -20` to understand this repo's commit message conventions. Then run `git diff --stat` and `git diff` to see all current changes. Generate a commit message matching the repo's style. Then use the question tool to ask me to confirm — do not just write the message in a normal reply. Include the proposed commit message in the question, with options like: Approve & push, Edit message (I'll provide a new one), Cancel. Only after I approve via the question tool, run `git add -A && git commit -m \"...\" && git push`."
    }
  },
  // Agent configuration
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-sol"
    },
    "explore": {
      "model": "openai/gpt-5.6-sol"
    }
  },

  "permission": {
    "external_directory": {
      "/home/nyx/.gradle/caches/**": "allow",
      "/tmp/*": "allow",
      "/home/nyx/Android/Sdk/platforms/*": "allow"
    }
  },

  // Plugins
  "plugin": [
    "@cortexkit/opencode-magic-context",
    "./plugins/cursor-completion-sound.ts"
  ],

  "compaction": {
    "auto": false,
    "prune": false
  }
}
